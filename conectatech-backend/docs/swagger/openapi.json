{
  "openapi": "3.0.1",
  "info": {
    "title": "ConectaTech API",
    "description": "API que conecta estudantes de diversos cursos da UNP a vagas de estagio na regiao de Mossoro/RN",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Autenticacao e registro de usuarios"
    },
    {
      "name": "Usuario",
      "description": "Perfil do estudante autenticado"
    },
    {
      "name": "Vagas",
      "description": "Busca e selecao de vagas de estagio"
    },
    {
      "name": "Admin",
      "description": "Gerenciamento de usuarios e vagas (requer role ADMIN)"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registrar novo estudante",
        "description": "Cria uma nova conta de estudante na plataforma",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Usuario registrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioDTO"
                }
              }
            }
          },
          "400": {
            "description": "Dados invalidos ou email ja cadastrado",
            "content": {}
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "Autentica o usuario e retorna um token JWT",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Email ou senha invalidos",
            "content": {}
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Solicitar recuperacao de senha",
        "description": "Gera um token de recuperacao para o email informado",
        "operationId": "forgotPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecuperarSenhaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Token de recuperacao gerado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Token de recuperacao gerado com sucesso"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Email nao encontrado",
            "content": {}
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "put": {
        "tags": [
          "Auth"
        ],
        "summary": "Alterar senha",
        "description": "Altera a senha usando o token de recuperacao",
        "operationId": "resetPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlterarSenhaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Senha alterada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Senha alterada com sucesso"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Token invalido ou expirado",
            "content": {}
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "Usuario"
        ],
        "summary": "Ver meus dados",
        "description": "Retorna os dados do estudante autenticado",
        "operationId": "getProfile",
        "responses": {
          "200": {
            "description": "Dados do usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioDTO"
                }
              }
            }
          },
          "401": {
            "description": "Token JWT ausente ou invalido",
            "content": {}
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Usuario"
        ],
        "summary": "Atualizar meus dados",
        "description": "Atualiza nome, curso e periodo do estudante autenticado",
        "operationId": "updateProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizarUsuarioRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Dados atualizados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioDTO"
                }
              }
            }
          },
          "400": {
            "description": "Dados invalidos",
            "content": {}
          },
          "401": {
            "description": "Token JWT ausente ou invalido",
            "content": {}
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "Vagas"
        ],
        "summary": "Listar vagas",
        "description": "Lista todas as vagas com filtros opcionais por texto, localizacao e fonte",
        "operationId": "listJobs",
        "parameters": [
          {
            "name": "busca",
            "in": "query",
            "description": "Texto para buscar em titulo, empresa e descricao",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "localizacao",
            "in": "query",
            "description": "Filtrar por localizacao (ex: Mossoro)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fonte",
            "in": "query",
            "description": "Filtrar por fonte: JOOBLE, JSOUP ou ADMIN",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de vagas retornada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VagaDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "tags": [
          "Vagas"
        ],
        "summary": "Buscar vaga por ID",
        "description": "Retorna os detalhes de uma vaga especifica",
        "operationId": "getJobById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID da vaga",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vaga encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VagaDTO"
                }
              }
            }
          },
          "404": {
            "description": "Vaga nao encontrada",
            "content": {}
          }
        }
      }
    },
    "/api/jobs/search-external": {
      "get": {
        "tags": [
          "Vagas"
        ],
        "summary": "Buscar vagas externas",
        "description": "Importa vagas do Jooble e retorna resultados do banco",
        "operationId": "searchExternal",
        "parameters": [
          {
            "name": "keywords",
            "in": "query",
            "description": "Palavras-chave para busca",
            "required": false,
            "schema": {
              "type": "string",
              "default": "estagio"
            }
          },
          {
            "name": "location",
            "in": "query",
            "description": "Localizacao da busca",
            "required": false,
            "schema": {
              "type": "string",
              "default": "Mossoro, RN"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vagas externas importadas e retornadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VagaDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/select": {
      "post": {
        "tags": [
          "Vagas"
        ],
        "summary": "Selecionar vaga",
        "description": "Adiciona uma vaga a lista de vagas selecionadas do estudante",
        "operationId": "selectJob",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelecionarVagaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Vaga selecionada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Vaga selecionada com sucesso"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token JWT ausente ou invalido",
            "content": {}
          },
          "404": {
            "description": "Vaga nao encontrada",
            "content": {}
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/jobs/my-selections": {
      "get": {
        "tags": [
          "Vagas"
        ],
        "summary": "Minhas vagas",
        "description": "Lista as vagas selecionadas pelo estudante autenticado",
        "operationId": "mySelections",
        "responses": {
          "200": {
            "description": "Lista de vagas selecionadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VagaDTO"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token JWT ausente ou invalido",
            "content": {}
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/jobs/my-selections/{vagaId}": {
      "delete": {
        "tags": [
          "Vagas"
        ],
        "summary": "Remover vaga selecionada",
        "description": "Remove uma vaga da lista de selecionadas do estudante",
        "operationId": "removeSelection",
        "parameters": [
          {
            "name": "vagaId",
            "in": "path",
            "description": "ID da vaga",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vaga removida das selecionadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Vaga removida das selecionadas"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token JWT ausente ou invalido",
            "content": {}
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
