    "/api/admin/import-jooble": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Importar vagas do Jooble",
        "description": "Busca e importa vagas da API Jooble para o banco de dados",
        "operationId": "importJooble",
        "parameters": [
          {
            "name": "keywords",
            "in": "query",
            "description": "Palavras-chave para busca",
            "required": false,
            "schema": {
              "type": "string",
              "default": "estagio tecnologia"
            }
          },
          {
            "name": "location",
            "in": "query",
            "description": "Localizacao da busca",
            "required": false,
            "schema": {
              "type": "string",
