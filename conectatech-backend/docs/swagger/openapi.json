        "operationId": "importScraper",
        "responses": {
          "200": {
            "description": "Scraping executado com quantidade de vagas importadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Scraping executado"
                    },
                    "vagasImportadas": {
                      "type": "integer",
                      "example": 15
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado",
