              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Importacao Jooble concluida"
                    },
                    "vagasImportadas": {
                      "type": "integer",
                      "example": 10
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado",
            "content": {}
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "RegistroRequest": {
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome completo",
            "example": "Pedro Victor"
          },
          "email": {
            "type": "string",
            "description": "Email do estudante",
            "example": "pedro@email.com"
          },
          "senha": {
            "type": "string",
            "description": "Senha (min 6 caracteres)",
            "minLength": 6,
            "example": "minhasenha123"
          },
          "curso": {
            "type": "string",
            "description": "Curso do estudante",
            "example": "Ciencia da Computacao"
          },
          "periodo": {
            "type": "string",
            "description": "Periodo atual",
            "example": "6"
          }
        },
        "description": "Dados para registro de novo estudante"
      },
      "LoginRequest": {
        "required": [
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email do usuario",
            "example": "aluno@email.com"
          },
          "senha": {
            "type": "string",
            "description": "Senha do usuario",
            "example": "minhasenha123"
          }
        },
        "description": "Dados para login"
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token JWT para autenticacao",
            "example": "eyJhbGciOiJIUzI1NiJ9..."
          },
          "nome": {
            "type": "string",
            "description": "Nome do usuario",
            "example": "Pedro Victor"
          },
